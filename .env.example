# simulator is the safe default; hardware mode is read-only
M32_MODE=simulator
M32_HOST=192.168.1.100
M32_PORT=10023
OSC_LISTEN_HOST=0.0.0.0
OSC_LISTEN_PORT=10024

# Native simulator binds to loopback only. Change to 0.0.0.0 only if
# another computer on your LAN needs to connect using M32-Edit.
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=10023
