# simulator is the default; hardware mode is read-only
M32_MODE=simulator
M32_HOST=192.168.1.100
M32_PORT=10023
OSC_LISTEN_HOST=0.0.0.0
OSC_LISTEN_PORT=10024

# IPv4 wildcard binding is required for M32-Edit broadcast discovery.
# This exposes the unauthenticated simulator to your LAN; use on a trusted network.
SIMULATOR_HOST=0.0.0.0
SIMULATOR_PORT=10023
SIMULATOR_NAME=M32-Simulation
SIMULATOR_MODEL=M32
SIMULATOR_FIRMWARE=4.06
SIMULATOR_SERVER_VERSION=V2.07
